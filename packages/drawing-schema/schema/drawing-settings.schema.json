{
  "$defs": {
    "AnnotationPreferences": {
      "additionalProperties": false,
      "properties": {
        "center_marks": {
          "default": true,
          "title": "Center Marks",
          "type": "boolean"
        },
        "centerlines": {
          "default": true,
          "title": "Centerlines",
          "type": "boolean"
        },
        "hole_callouts": {
          "default": true,
          "title": "Hole Callouts",
          "type": "boolean"
        }
      },
      "required": [
        "center_marks",
        "centerlines",
        "hole_callouts"
      ],
      "title": "AnnotationPreferences",
      "type": "object"
    },
    "Datum": {
      "additionalProperties": false,
      "properties": {
        "letter": {
          "pattern": "^[A-HJ-NPR-Z]$",
          "title": "Letter",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "letter",
        "target"
      ],
      "title": "Datum",
      "type": "object"
    },
    "DatumReference": {
      "additionalProperties": false,
      "properties": {
        "letter": {
          "pattern": "^[A-HJ-NPR-Z]$",
          "title": "Letter",
          "type": "string"
        },
        "material_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "letter",
        "material_condition"
      ],
      "title": "DatumReference",
      "type": "object"
    },
    "DimensionPreferences": {
      "additionalProperties": false,
      "properties": {
        "angles": {
          "default": true,
          "title": "Angles",
          "type": "boolean"
        },
        "decimal_places": {
          "default": 2,
          "maximum": 4,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "depths": {
          "default": true,
          "title": "Depths",
          "type": "boolean"
        },
        "diameters": {
          "default": true,
          "title": "Diameters",
          "type": "boolean"
        },
        "feature": {
          "default": true,
          "title": "Feature",
          "type": "boolean"
        },
        "holes": {
          "default": true,
          "title": "Holes",
          "type": "boolean"
        },
        "overall": {
          "default": true,
          "title": "Overall",
          "type": "boolean"
        },
        "radii": {
          "default": true,
          "title": "Radii",
          "type": "boolean"
        },
        "trailing_zeros": {
          "default": true,
          "description": "8.00 rather than 8 (SolidWorks-style)",
          "title": "Trailing Zeros",
          "type": "boolean"
        }
      },
      "required": [
        "overall",
        "feature",
        "holes",
        "radii",
        "diameters",
        "angles",
        "depths",
        "decimal_places",
        "trailing_zeros"
      ],
      "title": "DimensionPreferences",
      "type": "object"
    },
    "DimensionTolerance": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ToleranceKind"
        },
        "lower": {
          "default": 0.0,
          "description": "DEVIATION/LIMITS: lower deviation (signed)",
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "description": "SYMMETRIC: the \u00b1 value; DEVIATION/LIMITS: upper deviation",
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "upper",
        "lower"
      ],
      "title": "DimensionTolerance",
      "type": "object"
    },
    "DisplayStyle": {
      "enum": [
        "HIDDEN_LINES_REMOVED",
        "HIDDEN_LINES_VISIBLE",
        "SHADED_WITH_EDGES"
      ],
      "title": "DisplayStyle",
      "type": "string"
    },
    "DrawingKind": {
      "enum": [
        "GEOMETRY",
        "MANUFACTURING"
      ],
      "title": "DrawingKind",
      "type": "string"
    },
    "DrawingStandard": {
      "enum": [
        "ISO",
        "ASME"
      ],
      "title": "DrawingStandard",
      "type": "string"
    },
    "EngineeringField": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfoSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "default": "UNSPECIFIED",
          "enum": [
            "SPECIFIED",
            "UNSPECIFIED"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status",
        "value",
        "source"
      ],
      "title": "EngineeringField",
      "type": "object"
    },
    "EngineeringInformation": {
      "additionalProperties": false,
      "properties": {
        "angular_tolerance": {
          "$ref": "#/$defs/EngineeringField"
        },
        "coating": {
          "$ref": "#/$defs/EngineeringField"
        },
        "datum_scheme": {
          "$ref": "#/$defs/EngineeringField"
        },
        "gdt": {
          "$ref": "#/$defs/EngineeringField"
        },
        "general_tolerance": {
          "$ref": "#/$defs/EngineeringField"
        },
        "heat_treatment": {
          "$ref": "#/$defs/EngineeringField"
        },
        "inspection_requirements": {
          "$ref": "#/$defs/EngineeringField"
        },
        "linear_tolerance": {
          "$ref": "#/$defs/EngineeringField"
        },
        "manufacturing_process": {
          "$ref": "#/$defs/EngineeringField"
        },
        "material": {
          "$ref": "#/$defs/EngineeringField"
        },
        "surface_finish": {
          "$ref": "#/$defs/EngineeringField"
        }
      },
      "required": [
        "material",
        "general_tolerance",
        "linear_tolerance",
        "angular_tolerance",
        "gdt",
        "datum_scheme",
        "surface_finish",
        "heat_treatment",
        "coating",
        "inspection_requirements",
        "manufacturing_process"
      ],
      "title": "EngineeringInformation",
      "type": "object"
    },
    "FeatureControlFrame": {
      "additionalProperties": false,
      "properties": {
        "characteristic": {
          "$ref": "#/$defs/GdtCharacteristic"
        },
        "datums": {
          "items": {
            "$ref": "#/$defs/DatumReference"
          },
          "maxItems": 3,
          "title": "Datums",
          "type": "array"
        },
        "diameter_zone": {
          "default": false,
          "title": "Diameter Zone",
          "type": "boolean"
        },
        "material_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "tolerance": {
          "description": "tolerance zone size, mm",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "characteristic",
        "tolerance",
        "diameter_zone",
        "material_condition",
        "datums",
        "target"
      ],
      "title": "FeatureControlFrame",
      "type": "object"
    },
    "FeatureNote": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/Target"
        },
        "text": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "target",
        "text"
      ],
      "title": "FeatureNote",
      "type": "object"
    },
    "GdtCharacteristic": {
      "enum": [
        "STRAIGHTNESS",
        "FLATNESS",
        "CIRCULARITY",
        "CYLINDRICITY",
        "PROFILE_OF_A_LINE",
        "PROFILE_OF_A_SURFACE",
        "ANGULARITY",
        "PERPENDICULARITY",
        "PARALLELISM",
        "POSITION",
        "CONCENTRICITY",
        "SYMMETRY",
        "CIRCULAR_RUNOUT",
        "TOTAL_RUNOUT"
      ],
      "title": "GdtCharacteristic",
      "type": "string"
    },
    "GeneralNotes": {
      "additionalProperties": false,
      "description": "The default numbered drawing notes (on by default).\n\nNotes are assembled deterministically from these user entries, the rest of the drawing\nsettings and GeometryIR. Anything not supplied is printed as a [PLACEHOLDER] - never a\nguessed value.",
      "properties": {
        "edge_break": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sharp-edge break value, e.g. as specified",
          "title": "Edge Break"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "general_geometric_tolerance": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "General Geometric Tolerance"
        },
        "marking": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marking"
        },
        "masked_surfaces": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Masked Surfaces"
        },
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "process": {
          "$ref": "#/$defs/ManufacturingProcess",
          "default": "UNSPECIFIED"
        },
        "process_sequence": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "machining vs heat treatment / coating order",
          "title": "Process Sequence"
        },
        "supplier_bullets": {
          "default": true,
          "description": "print \"WHAT THE SUPPLIER MUST NOT ASSUME\"",
          "title": "Supplier Bullets",
          "type": "boolean"
        },
        "thread_class": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Class"
        }
      },
      "required": [
        "enabled",
        "process",
        "general_geometric_tolerance",
        "edge_break",
        "masked_surfaces",
        "thread_class",
        "process_sequence",
        "model_revision",
        "marking",
        "supplier_bullets"
      ],
      "title": "GeneralNotes",
      "type": "object"
    },
    "InfoSource": {
      "description": "Where a piece of engineering information came from.",
      "enum": [
        "USER",
        "CAD_MODEL"
      ],
      "title": "InfoSource",
      "type": "string"
    },
    "ManufacturingAnnotations": {
      "additionalProperties": false,
      "properties": {
        "datums": {
          "items": {
            "$ref": "#/$defs/Datum"
          },
          "title": "Datums",
          "type": "array"
        },
        "deburr_break_sharp_edges": {
          "default": false,
          "description": "print the standard edge note (user choice)",
          "title": "Deburr Break Sharp Edges",
          "type": "boolean"
        },
        "feature_notes": {
          "items": {
            "$ref": "#/$defs/FeatureNote"
          },
          "title": "Feature Notes",
          "type": "array"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FeatureControlFrame"
          },
          "title": "Frames",
          "type": "array"
        },
        "inspection_dimensions": {
          "description": "candidate ids marked for inspection",
          "items": {
            "type": "string"
          },
          "title": "Inspection Dimensions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Notes",
          "type": "array"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/RevisionEntry"
          },
          "maxItems": 12,
          "title": "Revisions",
          "type": "array"
        },
        "surface_finish_marks": {
          "items": {
            "$ref": "#/$defs/SurfaceFinishMark"
          },
          "title": "Surface Finish Marks",
          "type": "array"
        },
        "threads": {
          "items": {
            "$ref": "#/$defs/ThreadCallout"
          },
          "title": "Threads",
          "type": "array"
        },
        "tolerances": {
          "items": {
            "$ref": "#/$defs/DimensionTolerance"
          },
          "title": "Tolerances",
          "type": "array"
        }
      },
      "required": [
        "datums",
        "frames",
        "tolerances",
        "threads",
        "inspection_dimensions",
        "surface_finish_marks",
        "feature_notes",
        "notes",
        "revisions",
        "deburr_break_sharp_edges"
      ],
      "title": "ManufacturingAnnotations",
      "type": "object"
    },
    "ManufacturingProcess": {
      "enum": [
        "UNSPECIFIED",
        "CNC_MACHINED",
        "SHEET_METAL",
        "CASTING",
        "FORGING",
        "WELDMENT",
        "MOULDED",
        "ADDITIVE"
      ],
      "title": "ManufacturingProcess",
      "type": "string"
    },
    "MaterialCondition": {
      "enum": [
        "MMC",
        "LMC"
      ],
      "title": "MaterialCondition",
      "type": "string"
    },
    "ProjectionMethod": {
      "enum": [
        "FIRST_ANGLE",
        "THIRD_ANGLE"
      ],
      "title": "ProjectionMethod",
      "type": "string"
    },
    "RevisionEntry": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "default": "",
          "maxLength": 30,
          "title": "Approved By",
          "type": "string"
        },
        "date": {
          "default": "",
          "maxLength": 20,
          "title": "Date",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 80,
          "title": "Description",
          "type": "string"
        },
        "revision": {
          "maxLength": 4,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "description",
        "date",
        "approved_by"
      ],
      "title": "RevisionEntry",
      "type": "object"
    },
    "Sheet": {
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "$ref": "#/$defs/SheetOrientation",
          "default": "LANDSCAPE"
        },
        "size": {
          "$ref": "#/$defs/SheetSize",
          "default": "A3"
        }
      },
      "required": [
        "size",
        "orientation"
      ],
      "title": "Sheet",
      "type": "object"
    },
    "SheetOrientation": {
      "enum": [
        "LANDSCAPE",
        "PORTRAIT"
      ],
      "title": "SheetOrientation",
      "type": "string"
    },
    "SheetSize": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4"
      ],
      "title": "SheetSize",
      "type": "string"
    },
    "SurfaceFinishMark": {
      "additionalProperties": false,
      "properties": {
        "ra_um": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Ra Um",
          "type": "number"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "target",
        "ra_um"
      ],
      "title": "SurfaceFinishMark",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "description": "A GeometryIR feature (hole, boss, pattern, slot, pocket \u2026) or a single face.",
      "properties": {
        "face_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Id"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        }
      },
      "required": [
        "feature_id",
        "face_id"
      ],
      "title": "Target",
      "type": "object"
    },
    "ThreadCallout": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "thread depth; required for blind holes",
          "title": "Depth"
        },
        "designation": {
          "description": "e.g. M8x1.25-6H (as specified by the user)",
          "maxLength": 40,
          "minLength": 2,
          "title": "Designation",
          "type": "string"
        },
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "designation",
        "depth"
      ],
      "title": "ThreadCallout",
      "type": "object"
    },
    "TitleBlock": {
      "additionalProperties": false,
      "description": "Identification data - all user-supplied (never generated).",
      "properties": {
        "approved_by": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_date": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Date"
        },
        "checked_by": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked By"
        },
        "checked_date": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked Date"
        },
        "drawing_number": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawing Number"
        },
        "drawn_by": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawn By"
        },
        "drawn_date": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawn Date"
        },
        "mfg_by": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mfg By"
        },
        "mfg_date": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mfg Date"
        },
        "organization": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization"
        },
        "part_number": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part Number"
        },
        "qa_by": {
          "anyOf": [
            {
              "maxLength": 30,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qa By"
        },
        "qa_date": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qa Date"
        },
        "quantity": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "revision": {
          "anyOf": [
            {
              "maxLength": 4,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "weight": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "as stated by the user, e.g. '475 g'",
          "title": "Weight"
        }
      },
      "required": [
        "title",
        "part_number",
        "drawing_number",
        "revision",
        "organization",
        "weight",
        "quantity",
        "drawn_by",
        "drawn_date",
        "checked_by",
        "checked_date",
        "approved_by",
        "approved_date",
        "mfg_by",
        "mfg_date",
        "qa_by",
        "qa_date"
      ],
      "title": "TitleBlock",
      "type": "object"
    },
    "ToleranceKind": {
      "enum": [
        "SYMMETRIC",
        "DEVIATION",
        "LIMITS"
      ],
      "title": "ToleranceKind",
      "type": "string"
    },
    "ViewFrame": {
