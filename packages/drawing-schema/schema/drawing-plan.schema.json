{
  "$defs": {
    "AnnotationPreferences": {
      "additionalProperties": false,
      "properties": {
        "center_marks": {
          "default": true,
          "title": "Center Marks",
          "type": "boolean"
        },
        "centerlines": {
          "default": true,
          "title": "Centerlines",
          "type": "boolean"
        },
        "hole_callouts": {
          "default": true,
          "title": "Hole Callouts",
          "type": "boolean"
        }
      },
      "required": [
        "center_marks",
        "centerlines",
        "hole_callouts"
      ],
      "title": "AnnotationPreferences",
      "type": "object"
    },
    "AuxiliaryView": {
      "additionalProperties": false,
      "description": "RULES 1.5: the feature seen along its own axis (true size), drawn anywhere on the sheet and\nidentified by the arrow method (ISO 128-30): a lettered arrow in ``parent_view_id`` shows the\ndirection of sight, the view carries the same letter.",
      "properties": {
        "covers": {
          "description": "features shown true size in the view",
          "items": {
            "type": "string"
          },
          "title": "Covers",
          "type": "array"
        },
        "feature_id": {
          "description": "the view looks along this feature's axis / normal",
          "title": "Feature Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "pattern": "^[A-Z]{1,2}$",
          "title": "Label",
          "type": "string"
        },
        "parent_view_id": {
          "title": "Parent View Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "parent_view_id",
        "feature_id",
        "covers"
      ],
      "title": "AuxiliaryView",
      "type": "object"
    },
    "ConventionalBreak": {
      "additionalProperties": false,
      "description": "RULES 1.6: the uniform middle of ``feature_id`` (a long constant diameter) is left out of every view\nthat shows its axis horizontally; the two cut ends are drawn ``gap`` mm apart (model scale) with break\nlines, and dimensions across the break keep their true values. Derived from GeometryIR.",
      "properties": {
        "end": {
          "additionalItems": false,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "maxItems": 3,
          "minItems": 3,
          "title": "End",
          "type": "array"
        },
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "gap": {
          "exclusiveMinimum": 0,
          "title": "Gap",
          "type": "number"
        },
        "start": {
          "additionalItems": false,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "maxItems": 3,
          "minItems": 3,
          "title": "Start",
          "type": "array"
        }
      },
      "required": [
        "feature_id",
        "start",
        "end",
        "gap"
      ],
      "title": "ConventionalBreak",
      "type": "object"
    },
    "Datum": {
      "additionalProperties": false,
      "properties": {
        "letter": {
          "pattern": "^[A-HJ-NPR-Z]$",
          "title": "Letter",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "letter",
        "target"
      ],
      "title": "Datum",
      "type": "object"
    },
    "DatumReference": {
      "additionalProperties": false,
      "properties": {
        "letter": {
          "pattern": "^[A-HJ-NPR-Z]$",
          "title": "Letter",
          "type": "string"
        },
        "material_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "letter",
        "material_condition"
      ],
      "title": "DatumReference",
      "type": "object"
    },
    "DetailView": {
      "additionalProperties": false,
      "description": "An enlarged circular region of ``parent_view_id`` (RULES 1.4), drawn in free space on the sheet\nand labelled \"B (5:1)\"; the region is circled and lettered in the parent view.",
      "properties": {
        "center": {
          "anyOf": [
            {
              "additionalItems": false,
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "region centre, derived from GeometryIR: the feature's outermost edge point in the parent view",
          "title": "Center"
        },
        "covers": {
          "description": "features shown enlarged by this detail",
          "items": {
            "type": "string"
          },
          "title": "Covers",
          "type": "array"
        },
        "feature_id": {
          "description": "region is centred on this GeometryIR feature",
          "title": "Feature Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "pattern": "^[A-Z]{1,2}$",
          "title": "Label",
          "type": "string"
        },
        "parent_view_id": {
          "title": "Parent View Id",
          "type": "string"
        },
        "radius": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "region radius in model mm",
          "title": "Radius"
        },
        "scale": {
          "title": "Scale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "parent_view_id",
        "feature_id",
        "scale",
        "radius",
        "center",
        "covers"
      ],
      "title": "DetailView",
      "type": "object"
    },
    "DimensionPreferences": {
      "additionalProperties": false,
      "properties": {
        "angles": {
          "default": true,
          "title": "Angles",
          "type": "boolean"
        },
        "decimal_places": {
          "default": 2,
          "maximum": 4,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "depths": {
          "default": true,
          "title": "Depths",
          "type": "boolean"
        },
        "diameters": {
          "default": true,
          "title": "Diameters",
          "type": "boolean"
        },
        "feature": {
          "default": true,
          "title": "Feature",
          "type": "boolean"
        },
        "holes": {
          "default": true,
          "title": "Holes",
          "type": "boolean"
        },
        "overall": {
          "default": true,
          "title": "Overall",
          "type": "boolean"
        },
        "radii": {
          "default": true,
          "title": "Radii",
          "type": "boolean"
        },
        "trailing_zeros": {
          "default": true,
          "description": "8.00 rather than 8 (SolidWorks-style)",
          "title": "Trailing Zeros",
          "type": "boolean"
        }
      },
      "required": [
        "overall",
        "feature",
        "holes",
        "radii",
        "diameters",
        "angles",
        "depths",
        "decimal_places",
        "trailing_zeros"
      ],
      "title": "DimensionPreferences",
      "type": "object"
    },
    "DimensionSelection": {
      "additionalProperties": false,
      "description": "Selects a dimension candidate (produced deterministically from GeometryIR) for a view.\n\nThere is intentionally no value field: values come from GeometryIR only.",
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "view_id": {
          "title": "View Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "view_id"
      ],
      "title": "DimensionSelection",
      "type": "object"
    },
    "DimensionTolerance": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "fit": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z]{1,2}\\d{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "FIT: ISO 286 tolerance class, e.g. H7 (hole) or h6 (shaft)",
          "title": "Fit"
        },
        "kind": {
          "$ref": "#/$defs/ToleranceKind"
        },
        "lower": {
          "default": 0.0,
          "description": "DEVIATION/LIMITS: lower deviation (signed)",
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "description": "SYMMETRIC: the \u00b1 value; DEVIATION/LIMITS: upper deviation",
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "upper",
        "lower",
        "fit"
      ],
      "title": "DimensionTolerance",
      "type": "object"
    },
    "DisplayStyle": {
      "enum": [
        "HIDDEN_LINES_REMOVED",
        "HIDDEN_LINES_VISIBLE",
        "SHADED_WITH_EDGES"
      ],
      "title": "DisplayStyle",
      "type": "string"
    },
    "DrawingKind": {
      "enum": [
        "GEOMETRY",
        "MANUFACTURING"
      ],
      "title": "DrawingKind",
      "type": "string"
    },
    "DrawingStandard": {
      "enum": [
        "ISO",
        "ASME"
      ],
      "title": "DrawingStandard",
      "type": "string"
    },
    "EngineeringField": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/InfoSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "default": "UNSPECIFIED",
          "enum": [
            "SPECIFIED",
            "UNSPECIFIED"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status",
        "value",
        "source"
      ],
      "title": "EngineeringField",
      "type": "object"
    },
    "EngineeringInformation": {
      "additionalProperties": false,
      "properties": {
        "angular_tolerance": {
          "$ref": "#/$defs/EngineeringField"
        },
        "coating": {
          "$ref": "#/$defs/EngineeringField"
        },
        "datum_scheme": {
          "$ref": "#/$defs/EngineeringField"
        },
        "gdt": {
          "$ref": "#/$defs/EngineeringField"
        },
        "general_tolerance": {
          "$ref": "#/$defs/EngineeringField"
        },
        "heat_treatment": {
          "$ref": "#/$defs/EngineeringField"
        },
        "inspection_requirements": {
          "$ref": "#/$defs/EngineeringField"
        },
        "linear_tolerance": {
          "$ref": "#/$defs/EngineeringField"
        },
        "manufacturing_process": {
          "$ref": "#/$defs/EngineeringField"
        },
        "material": {
          "$ref": "#/$defs/EngineeringField"
        },
        "surface_finish": {
          "$ref": "#/$defs/EngineeringField"
        }
      },
      "required": [
        "material",
        "general_tolerance",
        "linear_tolerance",
        "angular_tolerance",
        "gdt",
        "datum_scheme",
        "surface_finish",
        "heat_treatment",
        "coating",
        "inspection_requirements",
        "manufacturing_process"
      ],
      "title": "EngineeringInformation",
      "type": "object"
    },
    "FeatureControlFrame": {
      "additionalProperties": false,
      "properties": {
        "characteristic": {
          "$ref": "#/$defs/GdtCharacteristic"
        },
        "datums": {
          "items": {
            "$ref": "#/$defs/DatumReference"
          },
          "maxItems": 3,
          "title": "Datums",
          "type": "array"
        },
        "diameter_zone": {
          "default": false,
          "title": "Diameter Zone",
          "type": "boolean"
        },
        "material_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "tolerance": {
          "description": "tolerance zone size, mm",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "characteristic",
        "tolerance",
        "diameter_zone",
        "material_condition",
        "datums",
        "target"
      ],
      "title": "FeatureControlFrame",
      "type": "object"
    },
    "FeatureNote": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/Target"
        },
        "text": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "target",
        "text"
      ],
      "title": "FeatureNote",
      "type": "object"
    },
    "FeatureRole": {
      "enum": [
        "MOUNTING_FACE",
        "SEALING_FACE",
        "BEARING_BORE",
        "CENTRAL_BORE",
        "BEARING_SEAT",
        "SHOULDER_FACE",
        "CLEARANCE_HOLES",
        "DOWEL_HOLE",
        "TAPPED_HOLE",
        "KEYWAY",
        "SEAL_GROOVE",
        "NONE"
      ],
      "title": "FeatureRole",
      "type": "string"
    },
    "GdtCharacteristic": {
      "enum": [
        "STRAIGHTNESS",
        "FLATNESS",
        "CIRCULARITY",
        "CYLINDRICITY",
        "PROFILE_OF_A_LINE",
        "PROFILE_OF_A_SURFACE",
        "ANGULARITY",
        "PERPENDICULARITY",
        "PARALLELISM",
        "POSITION",
        "CONCENTRICITY",
        "SYMMETRY",
        "CIRCULAR_RUNOUT",
        "TOTAL_RUNOUT"
      ],
      "title": "GdtCharacteristic",
      "type": "string"
    },
    "GeneralNotes": {
      "additionalProperties": false,
      "description": "The default numbered drawing notes (on by default).\n\nNotes are assembled deterministically from these user entries, the rest of the drawing\nsettings and GeometryIR. Anything not supplied is printed as a [PLACEHOLDER] - never a\nguessed value.",
      "properties": {
        "edge_break": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sharp-edge break value, e.g. as specified",
          "title": "Edge Break"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "general_geometric_tolerance": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "General Geometric Tolerance"
        },
        "marking": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marking"
        },
        "masked_surfaces": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Masked Surfaces"
        },
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "process": {
          "$ref": "#/$defs/ManufacturingProcess",
          "default": "UNSPECIFIED"
        },
        "process_sequence": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "machining vs heat treatment / coating order",
          "title": "Process Sequence"
        },
        "style": {
          "$ref": "#/$defs/NotesStyle",
          "default": "CONCISE"
        },
        "supplier_bullets": {
          "default": true,
          "description": "print \"WHAT THE SUPPLIER MUST NOT ASSUME\"",
          "title": "Supplier Bullets",
          "type": "boolean"
        },
        "thread_class": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Class"
        }
      },
      "required": [
        "enabled",
        "style",
        "process",
        "general_geometric_tolerance",
        "edge_break",
        "masked_surfaces",
        "thread_class",
        "process_sequence",
        "model_revision",
        "marking",
        "supplier_bullets"
      ],
      "title": "GeneralNotes",
      "type": "object"
    },
    "GeometryReference": {
      "additionalProperties": false,
      "properties": {
        "geometry_schema_version": {
          "title": "Geometry Schema Version",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_sha256",
        "geometry_schema_version"
      ],
      "title": "GeometryReference",
      "type": "object"
    },
    "InfoSource": {
      "description": "Where a piece of engineering information came from.",
      "enum": [
        "USER",
        "CAD_MODEL",
        "DEFAULT"
      ],
      "title": "InfoSource",
      "type": "string"
    },
    "ManufacturingAnnotations": {
      "additionalProperties": false,
      "properties": {
        "basic_dimensions": {
          "description": "candidate ids drawn as theoretically exact (boxed) dimensions",
          "items": {
            "type": "string"
          },
          "title": "Basic Dimensions",
          "type": "array"
        },
        "datums": {
          "items": {
            "$ref": "#/$defs/Datum"
          },
          "title": "Datums",
          "type": "array"
        },
        "deburr_break_sharp_edges": {
          "default": false,
          "description": "print the standard edge note (user choice)",
          "title": "Deburr Break Sharp Edges",
          "type": "boolean"
        },
        "feature_notes": {
          "items": {
            "$ref": "#/$defs/FeatureNote"
          },
          "title": "Feature Notes",
          "type": "array"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/FeatureControlFrame"
          },
          "title": "Frames",
          "type": "array"
        },
        "inspection_dimensions": {
          "description": "candidate ids marked for inspection",
          "items": {
            "type": "string"
          },
          "title": "Inspection Dimensions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Notes",
          "type": "array"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/RevisionEntry"
          },
          "maxItems": 12,
          "title": "Revisions",
          "type": "array"
        },
        "surface_finish_marks": {
          "items": {
            "$ref": "#/$defs/SurfaceFinishMark"
          },
          "title": "Surface Finish Marks",
          "type": "array"
        },
        "threads": {
          "items": {
            "$ref": "#/$defs/ThreadCallout"
          },
          "title": "Threads",
          "type": "array"
        },
        "tolerances": {
          "items": {
            "$ref": "#/$defs/DimensionTolerance"
          },
          "title": "Tolerances",
          "type": "array"
        }
      },
      "required": [
        "datums",
        "frames",
        "tolerances",
        "threads",
        "inspection_dimensions",
        "basic_dimensions",
        "surface_finish_marks",
        "feature_notes",
        "notes",
        "revisions",
        "deburr_break_sharp_edges"
      ],
      "title": "ManufacturingAnnotations",
      "type": "object"
    },
    "ManufacturingProcess": {
      "enum": [
        "UNSPECIFIED",
        "CNC_MACHINED",
        "SHEET_METAL",
        "CASTING",
        "FORGING",
        "WELDMENT",
        "MOULDED",
        "ADDITIVE"
      ],
      "title": "ManufacturingProcess",
      "type": "string"
    },
    "MaterialCondition": {
      "enum": [
        "MMC",
        "LMC"
      ],
      "title": "MaterialCondition",
      "type": "string"
    },
    "NotesStyle": {
      "enum": [
        "CONCISE",
        "FULL"
      ],
      "title": "NotesStyle",
      "type": "string"
    },
    "PlanUncertainty": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "related_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        }
      },
      "required": [
        "message",
        "related_ids"
      ],
      "title": "PlanUncertainty",
      "type": "object"
    },
    "ProjectionMethod": {
      "enum": [
        "FIRST_ANGLE",
        "THIRD_ANGLE"
      ],
      "title": "ProjectionMethod",
      "type": "string"
    },
    "RevisionEntry": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "default": "",
          "maxLength": 30,
          "title": "Approved By",
          "type": "string"
        },
        "date": {
          "default": "",
          "maxLength": 20,
          "title": "Date",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 80,
          "title": "Description",
          "type": "string"
        },
        "revision": {
          "maxLength": 4,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "description",
        "date",
        "approved_by"
      ],
      "title": "RevisionEntry",
      "type": "object"
    },
    "RoleAssignment": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "description": "1 for USER; the inference's confidence otherwise",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "description": {
          "description": "the feature in words, e.g. '\u00d840.00 THRU hole'",
          "title": "Description",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
