# Copy to .env and adjust. Never commit real secrets.

# --- API (prefix CADAI_) ---
CADAI_ENVIRONMENT=development
CADAI_STORAGE_DIR=var/storage
CADAI_DATABASE_URL=sqlite:///var/cadai.db
# docker-compose uses: postgresql+psycopg://cadai:${POSTGRES_PASSWORD}@postgres:5432/cadai
CADAI_CORS_ORIGINS=["http://localhost:5173"]
CADAI_MAX_UPLOAD_MB=100
CADAI_ANALYSIS_TIMEOUT_S=300
CADAI_ANALYSIS_MEMORY_MB=6144
CADAI_JOB_WORKERS=2

# --- later milestones ---
CADAI_QA_MAX_RETRIES=3
CADAI_OPENAI_MODEL=gpt-5.6-sol
CADAI_OPENAI_API_KEY=
# mock | worker  (mock results are always labelled MOCK, never presented as SolidWorks output)
CADAI_SOLIDWORKS_MODE=mock

# --- docker-compose ---
POSTGRES_PASSWORD=change-me
