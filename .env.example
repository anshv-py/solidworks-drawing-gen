# Copy to .env and adjust. Never commit real secrets.

# --- API (prefix CADAI_) ---
CADAI_ENVIRONMENT=development
CADAI_STORAGE_DIR=var/storage
CADAI_DATABASE_URL=sqlite:///var/cadai.db
# docker-compose uses: postgresql+psycopg://cadai:${POSTGRES_PASSWORD}@postgres:5432/cadai
CADAI_CORS_ORIGINS=["http://localhost:5173"]
CADAI_MAX_UPLOAD_MB=100
CADAI_ANALYSIS_TIMEOUT_S=300
CADAI_ANALYSIS_MEMORY_MB=6144
CADAI_JOB_WORKERS=2

# --- later milestones ---
CADAI_QA_MAX_RETRIES=3
# Planning LLM (Hugging Face transformers). ~865 GB of weights, multi-GPU; see docs/DRAWING_ENGINE.md
CADAI_LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro
CADAI_LLM_REVISION=
# transformers | openai_compatible (vLLM / SGLang / transformers serve at CADAI_LLM_ENDPOINT_URL)
CADAI_LLM_BACKEND=transformers
CADAI_LLM_ENDPOINT_URL=
# Only enable together with a pinned CADAI_LLM_REVISION: it runs code from the model repository.
CADAI_LLM_TRUST_REMOTE_CODE=false
CADAI_HF_TOKEN=
# mock | worker  (mock results are always labelled MOCK, never presented as SolidWorks output)
CADAI_SOLIDWORKS_MODE=mock

# --- docker-compose ---
POSTGRES_PASSWORD=change-me
